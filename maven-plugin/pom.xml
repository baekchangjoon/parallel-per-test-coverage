<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Built with Maven (not the Gradle multi-module build) because it produces a Maven plugin and
       needs the maven-plugin-plugin descriptor generator. Resolves io.github.beltian.pjacoco:pjacoco-agent from the
       repository (publish the agent with `./gradlew :agent:publishToMavenLocal` first). -->
  <groupId>io.github.beltian.pjacoco</groupId>
  <artifactId>pjacoco-maven-plugin</artifactId>
  <version>2.0.0</version>
  <packaging>maven-plugin</packaging>

  <name>pjacoco-maven-plugin</name>
  <description>Wires the pjacoco -javaagent for per-test coverage (mirrors jacoco:prepare-agent).</description>
  <url>https://github.com/beltian/parallel-per-test-coverage</url>

  <!-- Central-required metadata (mirrors the Gradle modules' shared POM config in build.gradle.kts). -->
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>beltian</id>
      <name>Changjoon Baek</name>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/beltian/parallel-per-test-coverage</url>
    <connection>scm:git:https://github.com/beltian/parallel-per-test-coverage.git</connection>
    <developerConnection>scm:git:https://github.com/beltian/parallel-per-test-coverage.git</developerConnection>
  </scm>

  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.version>3.9.9</maven.version>
    <pjacoco.agent.version>2.0.0</pjacoco.agent.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>3.13.1</version>
      <scope>provided</scope>
    </dependency>
    <!-- Bundled so the agent jar appears in the plugin's artifact map at runtime (like jacoco). -->
    <dependency>
      <groupId>io.github.beltian.pjacoco</groupId>
      <artifactId>pjacoco-agent</artifactId>
      <version>${pjacoco.agent.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>3.13.1</version>
        <configuration>
          <goalPrefix>pjacoco</goalPrefix>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- Central publish (credentials-gated): activate with `mvn -Pcentral deploy`. Requires GPG in the
       environment + a `central` server entry (Portal user token) in settings.xml — release.yml wires
       both from GitHub secrets. Default builds are unaffected (profile off). -->
  <profiles>
    <profile>
      <id>central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.7.0</version>
            <configuration>
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- Non-interactive signing in CI (key imported beforehand with gpg import). -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.5.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Manual "Publish" click in the Portal UI for the first releases (same policy as
                   the Gradle bundle's USER_MANAGED publishingType). -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
